---
import manifest from '../../docs_manifest.json';

const { entry } = Astro.locals.starlightRoute;
const document = manifest.entries.find((item) => Astro.url.pathname === `/generated/${item.target.replace(/\.md$/, '')}/`);
const section = document?.section || (Astro.url.pathname === '/reference/' ? '命令参考' : '使用文档');
---
<div class="page-heading">
  <nav class="page-context" aria-label="文档位置"><a href="/">文档中心</a><span aria-hidden="true">/</span><span>{section}</span></nav>
  <h1 id="_top">{entry.data.title}</h1>
  {entry.data.description && <p class="page-description">{entry.data.description}</p>}
</div>
