---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import product from '../generated/product.json';
---
{Astro.locals.starlightRoute.entry.data.template !== 'splash' && <DefaultFooter />}
<div class="site-footer" data-pagefind-ignore>
  <span>© {product.year} {product.name}</span>
  <nav aria-label="页脚链接">
    <a href="#_top">回到顶部 <span aria-hidden="true">↑</span></a>
    <a href="/generated/license/">许可条款</a>
    <a href="/generated/docs-index/">文档目录</a>
    <a href="https://github.com/PlaxtonFlarion/SoftwareCenter">Software Center <span aria-hidden="true">↗</span></a>
  </nav>
</div>
