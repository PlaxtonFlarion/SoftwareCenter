---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
import { Code } from '@astrojs/starlight/components';
import product from '../generated/product.json';
---
{Astro.url.pathname === '/' ? (
  <section class="home-hero" aria-labelledby="_top">
    <div class="hero-copy">
      <p class="eyebrow">{product.name} · 开发与自动化</p>
      <h1 id="_top" data-page-title>从第一条命令，<br />到完整的工作流。</h1>
      <p class="hero-description">编写代码、连接工具、处理设备与媒体任务。<br class="desktop-break" />从这里找到所需指南，开始你的下一步。</p>
      <div class="hero-actions">
        <a class="button-primary" href="/getting-started/">开始使用 <span aria-hidden="true">→</span></a>
        <a class="button-text" href="/reference/">查阅命令 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="install-panel">
      <div class="install-heading"><span class="terminal-symbol" aria-hidden="true">›_</span><span>安装 CLI</span><span class="install-platform">Windows · macOS</span></div>
      <Code code="npm install -g @craftline/mind" lang="bash" frame="none" />
      <div class="install-next"><span class="step-number">01</span><span>打开终端，运行安装命令</span></div>
      <div class="install-next"><span class="step-number">02</span><span>输入 <code>mind</code>，开始对话</span></div>
      <a class="install-help" href="/getting-started/#检查安装">安装遇到问题 <span aria-hidden="true">→</span></a>
    </div>
  </section>
) : <DefaultHero />}
