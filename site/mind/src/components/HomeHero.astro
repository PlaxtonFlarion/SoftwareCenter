---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
import { Code } from '@astrojs/starlight/components';
import product from '../generated/product.json';
---
{Astro.url.pathname === '/' ? (
  <section class="home-hero" aria-labelledby="_top">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow"><span aria-hidden="true"></span>{product.name} · 终端里的工程伙伴</p>
      <h1 id="_top" data-page-title>从第一条命令，<br /><span>到完整的工作流。</span></h1>
      <p class="hero-description">在你的项目中理解代码、完成修改、验证结果。<br class="desktop-break" />连接已有工具，让日常开发与自动化自然衔接。</p>
      <div class="hero-actions">
        <a class="button-primary" href="/getting-started/">开始使用 <span aria-hidden="true">→</span></a>
        <a class="button-text" href="/reference/">查阅命令 <span aria-hidden="true">→</span></a>
      </div>
      <ul class="hero-notes" aria-label="工作方式"><li>立足本地项目</li><li>按需连接工具</li><li>随时恢复会话</li></ul>
    </div>
    <section class="install-panel" aria-labelledby="install-title">
      <div class="install-heading"><span class="terminal-symbol" aria-hidden="true">›_</span><h2 id="install-title">从安装开始</h2><span class="install-platform">Windows · macOS</span></div>
      <p class="install-caption">打开终端，安装 CLI</p>
      <Code code="npm install -g @craftline/mind" lang="bash" frame="none" />
      <ol class="install-steps">
        <li><span class="step-number" aria-hidden="true">01</span><div><strong>确认安装</strong><span>运行 <code>mind --version</code> 检查版本</span></div></li>
        <li><span class="step-number" aria-hidden="true">02</span><div><strong>配置模型</strong><span>启动 <code>mind</code>，输入 <a href="/getting-started/#配置模型"><code>/preferences</code></a></span></div></li>
        <li><span class="step-number" aria-hidden="true">03</span><div><strong>开始第一条任务</strong><span>在项目目录中，说清你想完成什么</span></div></li>
      </ol>
      <div class="install-footer"><span>需要 Node.js 18 或更高版本</span><a class="install-help" href="/getting-started/#检查安装">安装帮助 <span aria-hidden="true">↗</span></a></div>
    </section>
  </section>
) : <DefaultHero />}
